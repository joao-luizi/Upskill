<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskManager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TaskManager.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="header-container">

            <!-- Logo -->
            <div class="logo">
                <span>TaskFlow</span>
            </div>

            <!-- Navegação -->
            <nav>
                <a href="#">Início</a>
                <a href="#">Tarefas</a>
                <button class="btn-primary">Nova Tarefa</button>
            </nav>

        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="footer-links">
            <a href="#">Política de Privacidade</a>
            <a href="#">Contactos</a>
            <a href="#">Termos de Utilização</a>
        </div>
        <p>© 2026 - Gestor de Tarefas</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
